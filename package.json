{
  "name": "harness-aijient-team",
  "version": "0.18.1",
  "description": "Team harness plugin: Claude-led multi-agent (Codex/Gemini/Cursor/OpenCode) scaffold & apply",
  "type": "module",
  "bin": {
    "harness-team": "./bin/harness-team.mjs"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "commands",
    "skills",
    ".claude-plugin",
    ".codex-plugin",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "docs:generate": "node scripts/generate-harness-overview.mjs",
    "docs:check": "node scripts/generate-harness-overview.mjs --check",
    "test": "node --test tests/*.test.mjs tests/e2e/*.test.mjs && node --test --test-concurrency=1 tests/perf/*.test.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:e2e": "node --test tests/e2e/*.test.mjs"
  },
  "keywords": ["claude-code", "plugin", "harness", "codex", "gemini", "cursor", "opencode"],
  "license": "MIT"
}
