{
  "id": "node",
  "label": "Node.js (JS/TS)",
  "match": { "stackIds": ["node", "react", "next", "react-native", "expo"] },
  "workspace": {
    "app": [
      { "runtimeDependency": "next" }, { "runtimeDependency": "expo" }, { "runtimeDependency": "react-native" },
      { "runtimeDependency": "react-dom" }
    ]
  },
  "pm": {
    "npm":  { "exec": "npx",       "run": "npm run" },
    "pnpm": { "exec": "pnpm exec", "run": "pnpm run" },
    "yarn": { "exec": "yarn",      "run": "yarn run" },
    "bun":  { "exec": "bunx",      "run": "bun run" }
  },
  "env": {
    "bootstrap": {
      "npm":  [{ "when": { "file": "package-lock.json" }, "run": "npm ci" }],
      "pnpm": [{ "when": { "file": "pnpm-lock.yaml" }, "run": "pnpm install --frozen-lockfile" }],
      "yarn": [
        { "when": { "fileContains": ["yarn.lock", "__metadata"] }, "run": "yarn install --immutable" },
        { "when": { "file": "yarn.lock" }, "run": "yarn install --frozen-lockfile" }
      ],
      "bun":  [{ "when": { "file": "bun.lock" }, "run": "bun install --frozen-lockfile" }]
    },
    "installTrace": {
      "npm":  [{ "when": { "fileContains": ["package-lock.json", "\"node_modules/"] }, "trace": ["node_modules"] }],
      "pnpm": [{ "when": { "file": "pnpm-lock.yaml" }, "trace": ["node_modules"] }],
      "yarn": [
        { "when": { "fileContains": ["yarn.lock", "__metadata"] }, "trace": [".yarn/install-state.gz", ".pnp.cjs", "node_modules"] },
        { "when": { "file": "yarn.lock" }, "trace": ["node_modules"] }
      ],
      "bun":  [{ "when": { "file": "bun.lock" }, "trace": ["node_modules"] }]
    }
  },
  "delegate": [
    {
      "when": { "file": "turbo.json" }, "run": "{exec} turbo run {tasks} --filter=...[HEAD]", "confirm": true,
      "tasks": [
        { "name": "lint", "when": { "fileContains": ["turbo.json", "\"lint\""] } },
        { "name": "typecheck", "when": { "fileContains": ["turbo.json", "\"typecheck\""] } },
        { "name": "test", "when": { "fileContains": ["turbo.json", "\"test\""] } }
      ]
    },
    {
      "when": { "file": "nx.json" }, "run": "{exec} nx affected -t {tasks} --base=HEAD", "confirm": true,
      "tasks": [{ "name": "lint" }, { "name": "typecheck" }, { "name": "test" }]
    }
  ],
  "commit": [
    { "when": { "file": "tsconfig.json" }, "run": "{exec} tsc --noEmit" },
    { "when": { "script": "lint" }, "run": "{run} lint", "confirm": true },
    { "when": { "script": "test" }, "run": "{run} test" }
  ],
  "format": [
    { "when": { "dependency": "prettier" }, "glob": "*.{ts,tsx,js,jsx,json}", "run": ["{exec} prettier --write"] }
  ]
}
