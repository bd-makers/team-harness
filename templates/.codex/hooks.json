{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "harness-team session-context --target \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
